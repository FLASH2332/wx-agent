# Weather Buddy — environment variables reference.
# Copy the values you need into `.env` (Lambdas / local) and `frontend/.env.local`.
# Never commit real values — `.env` and `.env.local` are gitignored.

# --- agent-handler Lambda ---
# OpenWeatherMap key ("One Call by Call" subscription — One Call API 3.0).
OWM_API_KEY=
# Bedrock model id (pinned by AGENTS.md — leave as-is).
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Name or ARN of the deployed tts-handler Lambda (filled after first SAM deploy).
TTS_LAMBDA_NAME=

# --- both Lambdas ---
# AWS region (pinned to us-east-1). Note: on Lambda this is provided by the
# runtime automatically; set it only for local runs.
AWS_REGION=us-east-1

# --- frontend (frontend/.env.local) ---
# API Gateway invoke URL (filled after first SAM deploy).
NEXT_PUBLIC_API_URL=
