# Weather Buddy — environment variables reference.
# Copy the values you need into `.env` (Lambdas / local) and `frontend/.env.local`.
# Never commit real values — `.env` and `frontend/.env.local` are gitignored.

# ─── agent-handler Lambda ────────────────────────────────────────────────────
# OpenWeatherMap API key (free tier — v2.5 current + forecast endpoints).
OWM_API_KEY=

# LLM via LiteLLM — swap providers/models by changing these three vars only.
# The model-id PREFIX selects the provider.
#
#   Self-hosted Ollama on EC2 (OpenAI-compatible):
#     LLM_MODEL_ID=openai/qwen2.5:3b-instruct
#     LLM_BASE_URL=http://<ec2-ip>:11434/v1
#     LLM_API_KEY=ollama
#
#   Groq (leave LLM_BASE_URL empty):
#     LLM_MODEL_ID=groq/llama-3.1-8b-instant
#     LLM_BASE_URL=
#     LLM_API_KEY=<your-groq-key>
#
LLM_MODEL_ID=
LLM_BASE_URL=
LLM_API_KEY=

# Name or ARN of the deployed tts-handler Lambda (filled after first SAM deploy).
TTS_LAMBDA_NAME=

# ─── both Lambdas ────────────────────────────────────────────────────────────
# AWS region (pinned to us-east-1). On Lambda this is provided by the runtime
# automatically; set it only for local runs.
AWS_REGION=us-east-1

# ─── frontend (frontend/.env.local) ──────────────────────────────────────────
# Use the Lambda Function URL (AgentFunctionUrl output from sam deploy) to avoid
# the API Gateway 29s hard timeout when running slow self-hosted models on EC2.
# Format: https://<id>.lambda-url.<region>.on.aws
NEXT_PUBLIC_API_URL=

# ─── Azure PostgreSQL (frontend/.env.local) ───────────────────────────────────
# Option 1: Full connection string (overrides individual vars below if set).
#   Format: postgresql://<user>:<password>@<host>:5432/<dbname>?sslmode=require
DATABASE_URL=

# Option 2: Individual connection parameters (used if DATABASE_URL is empty).
DB_HOST=
DB_PORT=5432
DB_NAME=wx_agent_db
DB_USER=
DB_PASSWORD=

# ─── JWT authentication secret (frontend/.env.local) ─────────────────────────
# Generate a secure random secret with:
#   cd frontend && npm run db:generate-secret
# NEVER commit this value. NEVER use a short or guessable string.
JWT_SECRET=
