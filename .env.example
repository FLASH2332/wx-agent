# ============ REQUIRED ============
OWM_API_KEY=                 # OpenWeatherMap key (free tier works)

# LLM through LiteLLM: the model-id PREFIX selects the provider. Works with any provider.
#   Groq:      LLM_MODEL_ID=groq/openai/gpt-oss-120b   LLM_BASE_URL=            LLM_API_KEY=<groq key>
#   Ollama:    LLM_MODEL_ID=openai/qwen2.5:7b-instruct LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama
#   OpenAI:    LLM_MODEL_ID=gpt-4o-mini                LLM_BASE_URL=            LLM_API_KEY=<openai key>
#   Bedrock:   LLM_MODEL_ID=bedrock/<model id>         (uses AWS credentials, no key)
# Legacy GROQ_API_KEY / GROQ_MODEL_ID are still understood if LLM_* are unset.
LLM_MODEL_ID=
LLM_API_KEY=
LLM_BASE_URL=

# ============ AWS ============
# ONE credentials mechanism: AWS CLI profiles. Create one per Learner Lab account (the keys expire with the lab
# session, about 4 h, so repeat when they do):
#     python scripts/set_lab_credentials.py wb-new          # the account that runs the agent
#     python scripts/set_lab_credentials.py wb-existing     # the account that holds S3 / SNS / EventBridge
# This file only NAMES the profile. AWS keys written here are ignored (with a warning): they used to shadow
# the profile, and only one account fits in a .env. Never leave AWS_PROFILE empty.
AWS_REGION=us-east-1
AWS_PROFILE=wb-new
# S3 bucket (same region) for Transcribe input. Empty = speech-to-text goes straight to the API backup.
# (Transcribe is denied in Learner Lab anyway.) After deploying the platform stack: its SttBucketName.
STT_S3_BUCKET=

# ============ PROVIDER ORDER (first = tried first, the rest are backups) ============
STT_PROVIDERS=aws-transcribe,openai
TRANSLATE_PROVIDERS=aws-translate,llm
TTS_PROVIDERS=polly,browser
LANG_STRATEGY=llm-native                  # llm-native (no translation cost) | translate-pivot

# Optional speech-to-text API overrides (default: derived from LLM_*; Groq -> whisper-large-v3-turbo)
# STT_API_BASE_URL=
# STT_API_KEY=
# STT_MODEL=

# ============ OPTIONAL TUNING (defaults are cost-conscious) 
# LLM_MAX_TOKENS=800
# ROUTER_MAX_TOKENS=900
# LLM_NUM_RETRIES=1
# LLM_REASONING_EFFORT=low        # low|medium|high, empty disables (reasoning models burn tokens thinking)
# ROUTER_MODEL_ID=               # optional cheaper 2nd model, same provider (own rate-limit bucket on Groq)
# DIAG_ENABLED=false             # true exposes GET /diag/aws (which AWS services this role can call)
# HISTORY_MESSAGES=6
# MAX_TEXT_CHARS=400
# WEATHER_CACHE_TTL_SECONDS=600
# POLLY_ENGINE=standard
# TTS_MAX_CHARS=400
# TTS_CACHE_DIR=.cache/tts
# STT_AWS_TIMEOUT_SECONDS=25
# STT_MAX_AUDIO_BYTES=3000000
# PROVIDER_COOLDOWN_SECONDS=60
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DEBUG_ERRORS=false
# HOST=127.0.0.1
# PORT=3001

# ============ frontend (frontend/.env.local) ============
# Backend BASE url, no path. Local: http://127.0.0.1:3001   Lambda: the Function URL.
# (A trailing /query from older setups still works.)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
